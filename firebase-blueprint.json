{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and account profile of a GoGlobal user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 1024 },
        "bio": { "type": "string", "maxLength": 500 },
        "country": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName"]
    },
    "Video": {
      "title": "Video",
      "description": "Cultural video contribution linking to YouTube",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "youtubeUrl": { "type": "string", "maxLength": 500 },
        "youtubeVideoId": { "type": "string", "maxLength": 32 },
        "thumbnail": { "type": "string", "maxLength": 500 },
        "countryId": { "type": "string", "maxLength": 64 },
        "countryName": { "type": "string", "maxLength": 100 },
        "region": { "type": "string", "maxLength": 100 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 150 },
        "tags": { "type": "array" },
        "contributorId": { "type": "string", "maxLength": 128 },
        "contributorName": { "type": "string", "maxLength": 120 },
        "contributorPhoto": { "type": "string", "maxLength": 1024 },
        "views": { "type": "number" },
        "likesCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "title",
        "description",
        "youtubeUrl",
        "youtubeVideoId",
        "countryId",
        "categoryId",
        "contributorId",
        "status"
      ]
    },
    "Country": {
      "title": "Country",
      "description": "Cultural country metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 4 },
        "flag": { "type": "string", "maxLength": 16 },
        "region": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "bannerImage": { "type": "string", "maxLength": 500 },
        "culturalHighlights": { "type": "array" },
        "videoCount": { "type": "number" }
      },
      "required": ["id", "name", "code", "flag"]
    },
    "Category": {
      "title": "Category",
      "description": "Cultural topic category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name"]
    },
    "Like": {
      "title": "Like",
      "description": "User like on a cultural video",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "videoId"]
    },
    "SavedVideo": {
      "title": "SavedVideo",
      "description": "User bookmarked cultural video",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "videoId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Community comment on a cultural video",
      "type": "object",
      "properties": {
        "videoId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userPhoto": { "type": "string", "maxLength": 1024 },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["videoId", "userId", "text"]
    },
    "Follow": {
      "title": "Follow",
      "description": "User following another contributor",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "maxLength": 128 },
        "followingId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["followerId", "followingId"]
    },
    "Report": {
      "title": "Report",
      "description": "Flagged inappropriate or inaccurate cultural content",
      "type": "object",
      "properties": {
        "videoId": { "type": "string", "maxLength": 128 },
        "reportedBy": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["videoId", "reportedBy", "reason", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for approvals, likes, comments, and follows",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 50 },
        "link": { "type": "string", "maxLength": 256 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "isRead"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "GoGlobal user profile"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Cultural video records"
    },
    "/countries/{countryId}": {
      "schema": "Country",
      "description": "Curated country metadata"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Cultural exploration categories"
    },
    "/likes/{likeId}": {
      "schema": "Like",
      "description": "Likes on cultural videos"
    },
    "/savedVideos/{saveId}": {
      "schema": "SavedVideo",
      "description": "User bookmarks"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Video comments"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "User follow relationships"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Content moderation reports"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User activity alerts"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Admin access control list"
    }
  }
}
